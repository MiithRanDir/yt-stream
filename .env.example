# ── YouTube Live Key Manager — environment ─────────────────────────
# Copy to .env.local for dev, and set the same keys in Vercel → Settings → Environment Variables.

# OAuth client (Web application) from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Public origin of this app. Must match an Authorized redirect URI:
#   http://localhost:3000                       (dev)
#   https://your-app.vercel.app                 (production)
# The redirect URI used is always  ${APP_URL}/api/auth/callback
APP_URL=http://localhost:3000

# Random string (32+ chars) used to encrypt the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
